{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/faq",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/intel",
      "destination": "/support",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/faq",
      "destination": "/support.html"
    },
    {
      "source": "/intel",
      "destination": "/support.html"
    }
  ]
}
