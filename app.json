{
  "expo": {
    "name": "ZCE",
    "slug": "ZCE",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zce",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.usahealthlife.zce",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "ZCE needs microphone access to record voice reps and proof.",
        "NSCameraUsageDescription": "ZCE needs camera access for drill camera modes and photo proof."
      }
    },
    "android": {
      "package": "com.usahealthlife.zce",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/zcelogoloading.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#070A12",
          "dark": {
            "backgroundColor": "#070A12"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "aiProxyUrl": "",
      "allowInsecureClientProviders": false,
      "revenuecat": {
        "entitlementId": "ZCE Pro",
        "monthlyProductId": "zce_director_monthly_sub",
        "yearlyProductId": "zce_director_yearly_sub",
        "iosApiKey": "",
        "androidApiKey": ""
      },
      "eas": {
        "projectId": "d97e9439-eb4a-498b-ab9a-862ee3f3a6a5"
      }
    },
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/d97e9439-eb4a-498b-ab9a-862ee3f3a6a5"
    }
  }
}
