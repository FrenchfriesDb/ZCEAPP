{
  "buildCommand": "npm --prefix landing/react install && npm --prefix landing/react run build",
  "outputDirectory": "landing/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/faq",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/intel",
      "destination": "/support",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/faq",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/intel",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/product",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/plans",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/support",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/terms",
      "destination": "/landing/dist/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/landing/dist/assets/:path*"
    }
  ]
}
