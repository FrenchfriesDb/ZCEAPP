{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/faq",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/intel",
      "destination": "/support",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/faq",
      "destination": "/landing/support.html"
    },
    {
      "source": "/intel",
      "destination": "/landing/support.html"
    },
    {
      "source": "/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/product",
      "destination": "/landing/product.html"
    },
    {
      "source": "/plans",
      "destination": "/landing/plans.html"
    },
    {
      "source": "/support",
      "destination": "/landing/support.html"
    },
    {
      "source": "/privacy",
      "destination": "/landing/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/landing/terms.html"
    },
    {
      "source": "/styles.css",
      "destination": "/landing/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/landing/app.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/landing/assets/:path*"
    }
  ]
}
