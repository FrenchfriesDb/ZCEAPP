# RevenueCat public SDK keys (safe to expose in client app bundle)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Firebase web config (public identifiers, still environment-managed)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI routing: use proxy in production (recommended)
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_ALLOW_INSECURE_CLIENT_PROVIDERS=false

# Optional local-only fallback if no proxy is available.
# Set EXPO_PUBLIC_ALLOW_INSECURE_CLIENT_PROVIDERS=true to use these directly from client.
AI_GROQ_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_KIMI_API_KEY=
AI_MISTRAL_API_KEY=
AI_GLM5_API_KEY=
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openai/gpt-4o-mini
AI_OPENROUTER_SITE_URL=http://localhost
AI_OPENROUTER_APP_NAME=ZCE AI Proxy
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
AI_ANTHROPIC_API_KEY=
